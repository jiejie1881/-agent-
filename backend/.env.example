APP_NAME=物流车辆智能分配系统
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://logistics:change_me@127.0.0.1:3306/logistics_dispatch?charset=utf8mb4
SQL_ECHO=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_ROOT=uploads
DELIVERY_PROOF_MAX_BYTES=5242880
AGENT_CHECKPOINT_PATH=agent_data/checkpoints.sqlite3

RAG_EMBEDDING_PROVIDER=openai-compatible
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_TIMEOUT=30
RAG_KNOWLEDGE_BASE_DIR=knowledge_base
RAG_VECTOR_STORE_DIR=rag_data/chroma
RAG_COLLECTION_NAME=logistics_knowledge
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=4
BUSINESS_TIMEZONE=Asia/Shanghai
QUALITY_LOAD_TARGET=0.8
