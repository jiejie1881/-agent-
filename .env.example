# Copy this file to .env and replace every empty sensitive value.
# Do not commit the resulting .env file.

MYSQL_DATABASE=logistics_dispatch
MYSQL_USER=logistics
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# The hostname must be "mysql" inside Docker Compose.
# URL-encode reserved characters in the database password.
# Format: mysql+pymysql://logistics:<URL_ENCODED_PASSWORD>@mysql:3306/logistics_dispatch?charset=utf8mb4
DATABASE_URL=

# Generate a random secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

SQL_ECHO=false
BACKEND_PORT=8000
FRONTEND_PORT=80
VITE_API_BASE_URL=/api/v1
UPLOAD_ROOT=/app/uploads
DELIVERY_PROOF_MAX_BYTES=5242880

# Optional AI Agent model settings. Leaving these empty does not prevent the
# logistics backend from starting; only Agent calls will fail configuration.
AGENT_PROVIDER=openai-compatible
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_TIMEOUT=30
AGENT_MAX_TOOL_CALLS=5
AGENT_PENDING_ACTION_EXPIRE_MINUTES=15
AGENT_HISTORY_MAX_MESSAGES=20
# Local durable LangGraph checkpoints (Docker uses its named volume).
AGENT_CHECKPOINT_PATH=/app/agent_data/checkpoints.sqlite3

# Optional RAG embedding settings. The API must expose an OpenAI-compatible
# /embeddings endpoint. Keys are local secrets and must never be committed.
RAG_EMBEDDING_PROVIDER=openai-compatible
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_TIMEOUT=30
RAG_KNOWLEDGE_BASE_DIR=/app/knowledge_base
RAG_VECTOR_STORE_DIR=/app/rag_data/chroma
RAG_COLLECTION_NAME=logistics_knowledge
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=4
BUSINESS_TIMEZONE=Asia/Shanghai
QUALITY_LOAD_TARGET=0.8
