# Copy this file to .env and replace every empty sensitive value.
# Do not commit the resulting .env file.

MYSQL_DATABASE=logistics_dispatch
MYSQL_USER=logistics
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# The hostname must be "mysql" inside Docker Compose.
# URL-encode reserved characters in the database password.
# Format: mysql+pymysql://logistics:<URL_ENCODED_PASSWORD>@mysql:3306/logistics_dispatch?charset=utf8mb4
DATABASE_URL=

# Generate a random secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

SQL_ECHO=false
BACKEND_PORT=8000
FRONTEND_PORT=80
VITE_API_BASE_URL=/api/v1
UPLOAD_ROOT=/app/uploads
DELIVERY_PROOF_MAX_BYTES=5242880

# Optional AI Agent model settings. Leaving these empty does not prevent the
# logistics backend from starting; only Agent calls will fail configuration.
AGENT_PROVIDER=openai-compatible
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_TIMEOUT=30
# Optional metadata-only Agent observability; no key needed when disabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=logistics-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
AGENT_MAX_TOOL_CALLS=5
AGENT_WRITE_TOOLS_ENABLED=false
AGENT_DISPATCH_SHADOW_ENABLED=false
AGENT_DRAFT_ACCEPT_ENABLED=false
AGENT_DRAFT_ACCEPT_ADMIN_ENABLED=false
AGENT_DRAFT_ACCEPT_DISPATCHER_ENABLED=false
AGENT_PLAN_PUBLISH_ENABLED=false
AGENT_PLAN_PUBLISH_ADMIN_ENABLED=false
AGENT_PLAN_PUBLISH_DISPATCHER_ENABLED=false
# Distinct secret, at least 32 bytes; required only when both flags are true.
# AGENT_DRAFT_RECEIPT_SECRET=<new-random-secret>
AGENT_DRAFT_RECEIPT_TTL_SECONDS=300
AGENT_DRAFT_RECEIPT_KEY_VERSION=1
AGENT_PUBLISH_RECEIPT_TTL_SECONDS=300
AGENT_DISPATCH_SHADOW_MAX_REVISIONS=2
AGENT_DISPATCH_SHADOW_TIMEOUT=90
AGENT_DISPATCH_SHADOW_MAX_INPUT_BYTES=100000
AGENT_DISPATCH_SHADOW_MAX_OUTPUT_BYTES=50000
AGENT_DISPATCH_SHADOW_OUTPUT_TOKENS=4096
AGENT_DISPATCH_SHADOW_TOKEN_BUDGET=100000
# Monetary guard (required for production Agent planning): configure trusted per-million prices and currency
# together with AGENT_DISPATCH_SHADOW_MAX_COST. Missing rates fail closed.
# AGENT_DISPATCH_SHADOW_MAX_COST=<budget-in-configured-currency>
# AGENT_DISPATCH_SHADOW_INPUT_PRICE_PER_MILLION=<verified-input-price>
# AGENT_DISPATCH_SHADOW_OUTPUT_PRICE_PER_MILLION=<verified-output-price>
# AGENT_DISPATCH_SHADOW_COST_CURRENCY=<billing-currency>
AGENT_PENDING_ACTION_EXPIRE_MINUTES=15
AGENT_HISTORY_MAX_MESSAGES=20
# Local durable LangGraph checkpoints (Docker uses its named volume).
AGENT_CHECKPOINT_PATH=/app/agent_data/checkpoints.sqlite3

# Optional RAG embedding settings. The API must expose an OpenAI-compatible
# /embeddings endpoint. Keys are local secrets and must never be committed.
RAG_EMBEDDING_PROVIDER=openai-compatible
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_TIMEOUT=30
RAG_KNOWLEDGE_BASE_DIR=/app/knowledge_base
RAG_VECTOR_STORE_DIR=/app/rag_data/chroma
RAG_COLLECTION_NAME=logistics_knowledge
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=4
RAG_RETRIEVAL_MODE=vector
RAG_VECTOR_CANDIDATES=20
RAG_BM25_CANDIDATES=20
RAG_RRF_K=60
BUSINESS_TIMEZONE=Asia/Shanghai
QUALITY_LOAD_TARGET=0.8
# Stage 3 optional safeguards. Apply production values only in a separately reviewed release.
APP_ENVIRONMENT=development
API_DOCS_ENABLED=true
RUN_MIGRATIONS=true
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL_PATH=
RAG_RERANKER_TIMEOUT=10
RAG_RERANKER_CANDIDATE_K=20
