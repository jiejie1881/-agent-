<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><view class="label">失败原因</view><picker mode="selector" range="{{reasons}}" range-key="label" value="{{reasonIndex}}" bindchange="onReason"><view class="picker">{{reasons[reasonIndex].label}} <text>请选择 ›</text></view></picker><view class="label">情况说明 <text wx:if="{{reasons[reasonIndex].value === 'OTHER'}}">*</text></view><textarea class="textarea" value="{{remark}}" maxlength="1000" placeholder="请描述门店现场情况" bindinput="onRemark" /></view><button class="danger-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">确认配送失败</button></view>
