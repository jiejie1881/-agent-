.personal-center { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.profile-card { text-align: center; }
.avatar { width: 112rpx; height: 112rpx; margin: 0 auto; border-radius: 50%; color: #fff; background: linear-gradient(135deg, #1769e0, #65a7ff); font-size: 44rpx; line-height: 112rpx; }
.name { margin-top: 20rpx; font-size: 36rpx; font-weight: 700; overflow-wrap: anywhere; }
.role { margin: 12rpx 0; color: #7b8794; font-size: 26rpx; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 18rpx; }
.item { display: flex; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #eef1f5; }
.item:last-child { border: 0; }
.item > text:first-child { color: #7b8794; flex-shrink: 0; }
.value { font-weight: 600; text-align: right; margin-left: 24rpx; overflow-wrap: anywhere; }
.warning { padding: 24rpx; border-radius: 12rpx; color: #a56600; background: #fff8e8; }
.feedback { text-align: center; color: #7b8794; }
.feedback button { margin-top: 24rpx; }
.shortcuts button { background: #fff; text-align: left; font-size: 28rpx; line-height: 96rpx; }
.shortcuts button::after { border: 0; }
.arrow { float: right; color: #7b8794; }
.logout { margin-top: 36rpx; font-size: 30rpx; line-height: 96rpx; border-radius: 16rpx; }
.footer { padding-top: 24rpx; text-align: center; font-size: 24rpx; color: #7b8794; }
.logout-confirm { margin-top: 24rpx; border: 2rpx solid #ffe2e2; }
.confirm-actions { display: flex; gap: 24rpx; }
.confirm-actions button { flex: 1; font-size: 28rpx; }
