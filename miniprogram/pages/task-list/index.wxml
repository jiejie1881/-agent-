<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!loading && !tasks.length}}" class="empty">今天暂无配送任务</view><view wx:for="{{tasks}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openTask"><view class="row"><view class="task-title">{{item.route.name}} · 第{{item.trip_no}}趟</view><view class="status">{{item.status}}</view></view><view class="detail">{{item.period === 'MORNING' ? '上午' : '下午'}}｜{{item.stop_count}} 个门店｜载重 {{item.total_load}}｜{{item.highest_priority}}</view></view></view>
