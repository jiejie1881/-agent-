<view class="page"><view class="card filters"><view class="date-row"><picker mode="date" value="{{dateFrom}}" bindchange="onDateFrom"><view class="date-input">{{dateFrom || '开始日期'}}</view></picker><text>至</text><picker mode="date" value="{{dateTo}}" bindchange="onDateTo"><view class="date-input">{{dateTo || '结束日期'}}</view></picker></view><button class="primary-button" size="mini" bindtap="search">查询</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!loading && !items.length}}" class="empty">暂无历史任务</view><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openTask"><view class="row"><strong>{{item.delivery_date}} · {{item.route.name}}</strong><view class="status">{{item.status}}</view></view><view class="subtle history-meta">{{item.period === 'MORNING' ? '上午' : '下午'}} · 第{{item.trip_no}}趟 · {{item.stop_count}}个门店</view></view><view wx:if="{{loading}}" class="loading">加载中...</view><view wx:if="{{!loading && items.length && items.length >= total}}" class="loading">已加载全部 {{total}} 条</view></view>
