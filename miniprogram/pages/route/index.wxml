<view class="route-page"><view wx:if="{{error}}" class="error route-error">{{error}}</view><map class="map" latitude="{{latitude}}" longitude="{{longitude}}" scale="12" markers="{{markers}}" polyline="{{polyline}}" show-location></map><scroll-view wx:if="{{task}}" class="stop-list" scroll-y><view wx:for="{{task.stops}}" wx:key="delivery_demand_id" class="stop-row"><view><strong>{{item.sequence}}. {{item.store_name}}</strong><view class="subtle">{{item.address || '未填写地址'}}</view></view><button size="mini" data-sequence="{{item.sequence}}" bindtap="navigate">导航</button></view></scroll-view></view>
