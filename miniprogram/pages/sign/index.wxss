.store-card .title { font-size: 34rpx; }.form-card { padding-bottom: 36rpx; }.label { margin: 28rpx 0 12rpx; color: #52616f; }.label text { color: #e5484d; }.input,.textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #dce3ed; border-radius: 14rpx; background: #f9fbfd; }.input { height: 86rpx; padding: 0 22rpx; }.textarea { height: 180rpx; padding: 20rpx; }.media-list { display: flex; flex-wrap: wrap; gap: 16rpx; }.media-wrap { position: relative; }.media { width: 150rpx; height: 150rpx; border-radius: 12rpx; }.media.add { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #1769e0; border: 2rpx dashed #9dc3f5; background: #f3f8ff; font-size: 48rpx; }.media.add text { font-size: 22rpx; }.remove { position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; border-radius: 50%; color: #fff; background: #e5484d; line-height: 36rpx; text-align: center; }.submit { margin-top: 30rpx; }
