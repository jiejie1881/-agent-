.header-card { background: linear-gradient(145deg,#fff,#f4f8ff); }.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-top: 30rpx; }.grid view { display: flex; flex-direction: column; }.grid text { color: #8993a4; font-size: 23rpx; }.grid strong { margin-top: 8rpx; }.route-button { margin-top: 28rpx; border: 1rpx solid #1769e0; color: #1769e0; background: #fff; }.section-title { margin: 30rpx 0 18rpx; font-size: 31rpx; font-weight: 700; }.stop { display: flex; gap: 22rpx; }.number { flex: 0 0 auto; width: 52rpx; height: 52rpx; border-radius: 50%; color: #fff; background: #1769e0; text-align: center; line-height: 52rpx; }.stop-body { min-width: 0; flex: 1; }.stop-name { font-weight: 650; }.goods { margin-top: 14rpx; color: #1769e0; font-size: 24rpx; }.stop-status { padding: 5rpx 12rpx; border-radius: 999rpx; font-size: 21rpx; background: #eef2f6; color: #67768a; }.status-ARRIVED { background: #fff2d8; color: #9a6300; }.status-SIGNED { background: #e8f7ed; color: #278a4b; }.status-FAILED { background: #fff0f0; color: #c53b3e; }.result-info { margin-top: 14rpx; padding: 12rpx; border-radius: 10rpx; color: #278a4b; background: #f0faf3; font-size: 23rpx; }.result-info.failed { color: #c53b3e; background: #fff4f3; }.stop-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }.stop-actions button { margin: 0; min-width: 150rpx; }.proofs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }.proof { width: 120rpx; height: 120rpx; border-radius: 10rpx; }.action-bar { position: sticky; bottom: 0; padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); background: #f4f7fb; }.pending-tip { margin-bottom: 12rpx; color: #c17400; text-align: center; font-size: 24rpx; }.readonly { padding: 24rpx; border-radius: 14rpx; text-align: center; color: #67768a; background: #e8edf3; }
